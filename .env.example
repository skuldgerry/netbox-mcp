# NetBox MCP Server Configuration
# Copy this file to .env and customize for your environment

# ===== Core NetBox Configuration (REQUIRED) =====
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=your_api_token_here

# ===== Transport Configuration =====
# Options: stdio (default, for Claude Desktop/Code) or http (for web clients)
TRANSPORT=stdio

# ===== HTTP Transport Settings =====
# Only used when TRANSPORT=http
HOST=127.0.0.1
PORT=8000

# ===== Security Settings =====
# Optional shared bearer token protecting the HTTP MCP endpoint.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Clients send it as: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# JSON list of browser origins allowed to access the HTTP transport.
CORS_ORIGINS='["http://localhost:6274"]'

# ===== Plugin Discovery =====
# Opt in to discovering installed NetBox plugin models with REST endpoints.
# Discovered plugin types are read-only unless an exact operation is allowlisted below.
ENABLE_PLUGIN_DISCOVERY=false

# JSON object mapping exact dotted plugin types to allowed generic write operations.
# Example: {"netbox_dns.zone":["create","update"]}
PLUGIN_WRITE_RULES={}

# Set to false only for testing with self-signed certificates
VERIFY_SSL=true

# ===== Logging Configuration =====
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
